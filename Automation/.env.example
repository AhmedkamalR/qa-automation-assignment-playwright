# ===========================================
# Test Environment Configuration
# ===========================================
# Copy this file to .env and update the values as needed
# Do NOT commit .env to version control

# Base URL for the application under test
BASE_URL=https://automationexercise.com

# ===========================================
# User Credentials
# ===========================================

# Valid user credentials for login tests
VALID_USER_EMAIL=your_valid_email@example.com
VALID_USER_PASSWORD=your_password

# Invalid user credentials for negative tests
INVALID_USER_EMAIL=wrong@test.com
INVALID_USER_PASSWORD=wrong

# ===========================================
# Test Data
# ===========================================

# Product search keyword
PRODUCT_SEARCH_KEYWORD=Dress

# ===========================================
# Test Configuration
# ===========================================

# Timeout settings (in milliseconds)
DEFAULT_TIMEOUT=30000
NAVIGATION_TIMEOUT=30000

# Retry count for flaky tests
RETRY_COUNT=0
